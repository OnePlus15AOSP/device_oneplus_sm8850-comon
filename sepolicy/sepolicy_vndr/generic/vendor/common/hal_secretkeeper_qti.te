type vendor_hal_secretkeeper_qti, domain;
hal_server_domain(vendor_hal_secretkeeper_qti, hal_secretkeeper)

type vendor_hal_secretkeeper_qti_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_secretkeeper_qti)

dontaudit vendor_hal_secretkeeper_qti firmware_file:dir search;

allow vendor_hal_secretkeeper_qti tee_device:chr_file rw_file_perms;
# Allow secretkeeper HAL to wait for listeners.
get_prop(vendor_hal_secretkeeper_qti, vendor_tee_listener_prop)
