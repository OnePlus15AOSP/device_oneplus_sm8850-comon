type vendor_wifi_qos_daemon, domain;
type vendor_wifi_qos_daemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_wifi_qos_daemon)
net_domain(vendor_wifi_qos_daemon)

allowxperm vendor_wifi_qos_daemon self:udp_socket ioctl { SIOCIWFIRSTPRIV_05 SIOCSIFFLAGS };

allow vendor_wifi_qos_daemon self:netlink_generic_socket create_socket_perms_no_ioctl;
allow vendor_wifi_qos_daemon self:netlink_socket create_socket_perms_no_ioctl;

unix_socket_connect(vendor_wifi_qos_daemon, vendor_ssgtzd, vendor_hlosminkdaemon)

# Allow read access to mink socket log files
userdebug_or_eng(`
  get_prop(vendor_wifi_qos_daemon, vendor_mink_trace_prop)
')

# provide net_admin capability to wifi-qos daemon.
allow vendor_wifi_qos_daemon self:capability { net_admin };

# /data/vendor/wifi
allow vendor_wifi_qos_daemon vendor_wifi_vendor_data_file:dir search;

# /data/vendor/wifi/wpa
allow vendor_wifi_qos_daemon wpa_data_file:dir rw_dir_perms;
allow vendor_wifi_qos_daemon wpa_data_file:sock_file create_file_perms;
allow vendor_wifi_qos_daemon hal_wifi_supplicant_default:unix_dgram_socket sendto;

allow vendor_wifi_qos_daemon vendor_txpb_device:chr_file r_file_perms;
dontaudit vendor_wifi_qos_daemon default_prop:file read;
allow vendor_wifi_qos_daemon vendor_wifi_tx_powerboost_file:dir rw_dir_perms;
allow vendor_wifi_qos_daemon vendor_wifi_tx_powerboost_file:file create_file_perms;

